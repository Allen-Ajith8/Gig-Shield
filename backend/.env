# ─── LLM Provider ───────────────────────────────────────────
# Supported: "openai", "anthropic", "google", "ollama"
LLM_PROVIDER=ollama

# Provider API keys (only needed for cloud providers)
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me
GOOGLE_API_KEY=replace-me

# Model name passed to the provider
LLM_MODEL_NAME=llama3

# Ollama local server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Application ────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Sandbox ────────────────────────────────────────────────
# "mock" for simulated sandbox, "docker" for real Docker containers
SANDBOX_MODE=mock
