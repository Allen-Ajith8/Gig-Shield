# ─── LLM Provider ───────────────────────────────────────────
# Supported: "openai", "anthropic", "google"
LLM_PROVIDER=openai

# Provider API keys (set the one matching LLM_PROVIDER)
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me
GOOGLE_API_KEY=replace-me

# Model name passed to the provider (e.g. gpt-4o, claude-3-5-sonnet-20240620)
LLM_MODEL_NAME=gpt-4o

# ─── Application ────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Sandbox ────────────────────────────────────────────────
# "mock" for simulated sandbox, "docker" for real Docker containers
SANDBOX_MODE=mock
